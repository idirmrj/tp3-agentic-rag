---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	agent(agent)
	tools(tools)
	generate(generate)
	verifier(verifier)
	final(final)
	__end__([<p>__end__</p>]):::last
	__start__ --> agent;
	agent -.-> final;
	agent -.-> generate;
	agent -.-> tools;
	generate --> verifier;
	tools --> agent;
	verifier -.-> agent;
	verifier -.-> final;
	final --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
